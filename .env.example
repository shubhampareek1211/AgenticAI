# Load explicitly in your shell; the app does not auto-load .env files.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://cricket@127.0.0.1:55432/cricket_analyst
TEST_DATABASE_URL=postgresql+psycopg://cricket@127.0.0.1:55432/cricket_test
# For a Cloud Run pilot set APP_ENV=pilot and all four FIREBASE_* values below.
# Never deploy Cloud Run with APP_ENV=local or test.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# PostgreSQL-backed UTC daily voice attempts (dictation and generated speech);
# used only in pilot/production. Failed synthesis attempts also consume quota.
VOICE_USER_DAILY_LIMIT=10
VOICE_GLOBAL_DAILY_LIMIT=100
# Cloud configuration.
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_LOCATION=global
GEMINI_MODEL=vertex_ai/gemini-3.5-flash-lite
ESPN_TIMEOUT_SECONDS=10
PROFILE_CACHE_HOURS=24
MAX_TOOL_ROUNDS=5
CONTEXT_TOKEN_BUDGET=12000
MODEL_TIMEOUT_SECONDS=60

# Optional voice dictation. English: small.en; Hindi/auto: multilingual small.
# Keep false until the worker and browser flow have been verified.
VOICE_ENABLED=false
VOICE_LANGUAGES=en
# Set en,hi,auto only when STT_BASE_URL points to a multilingual model (small, not small.en).
STT_PROVIDER=whisper_cpp
STT_BASE_URL=http://127.0.0.1:8081
STT_AUTH_MODE=none
# Required only with STT_AUTH_MODE=google_id_token.
STT_AUDIENCE=
VOICE_MAX_DURATION_SECONDS=60
VOICE_MAX_UPLOAD_BYTES=8388608
VOICE_MAX_BODY_BYTES=10485760
STT_CONVERSION_TIMEOUT_SECONDS=10
STT_INFERENCE_TIMEOUT_SECONDS=45
VOICE_MAX_CONCURRENT=1

# Optional Kokoro read-aloud pilot. English generation only; Hindi uses the
# browser voice. Keep false until the private worker has passed listening and
# latency checks. The app remains functional with TTS disabled.
TTS_ENABLED=false
TTS_BASE_URL=http://127.0.0.1:8082
TTS_AUTH_MODE=none
# Required with TTS_AUTH_MODE=google_id_token; use the private Cloud Run URL.
TTS_AUDIENCE=
TTS_TIMEOUT_SECONDS=90
TTS_MAX_CONCURRENT=1
